# Code9 Fitness — environment template. Copy to .env.local and fill in.
# Every var is optional for local dev; features degrade gracefully when blank.

# Coach chat — Anthropic (Claude Sonnet 5). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Email that unlocks /admin (defaults to code9.fit@proton.me).
NEXT_PUBLIC_ADMIN_EMAIL=code9.fit@proton.me

# Payments — Lemon Squeezy (Merchant of Record; handles VAT + delivery).
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_ONE_TIME=
LEMONSQUEEZY_VARIANT_SUBSCRIPTION=
LEMONSQUEEZY_VARIANT_PREMIUM=

# Auth + data layer — Supabase. Run supabase/schema.sql; see SUPABASE_SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
